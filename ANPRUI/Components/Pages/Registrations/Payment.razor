@page "/payment"

<PageTitle>Parking Payment</PageTitle>

<MudPaper Class="pa-4" MaxWidth="MaxWidth.Small">

    <MudText Typo="Typo.h5" Class="mb-4">
        Parking Payment
    </MudText>

    <MudTextField T="string"
                  @bind-Value="RegistrationNumber"
                  Label="Registration Number"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Class="mb-4" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="RetrieveParkingDetails">
        Retrieve Parking Details
    </MudButton>

    @if (SearchPerformed && !PaymentSuccessful)
    {
        @if (ParkingRegistration is not null)
        {
            <MudDivider Class="my-4" />

            <MudPaper Class="pa-4">

                <MudText Typo="Typo.h6">
                    Parking Details
                </MudText>

                <MudText>
                    Registration Number: @ParkingRegistration.RegistrationNumber
                </MudText>

                <MudText>
                    Date Parked: @ParkingRegistration.DateParked
                </MudText>

                <MudText>
                    Date Departed: @ParkingRegistration.DateDeparted
                </MudText>

                <MudText>
                    Parking Duration: @ParkingDuration
                </MudText>

                <MudText>
                    Parking Charge: £@ParkingRegistration.ParkingCharge
                </MudText>

                @if (ParkingRegistration.RegistrationPhoto is not null)
                {
                    <MudPaper Class="mt-4 mb-4 pa-2">

                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Vehicle Registration Photo
                        </MudText>

                        <MudImage Src="@($"data:image/png;base64,{Convert.ToBase64String(ParkingRegistration.RegistrationPhoto)}")"
                                  Alt="Vehicle registration"
                                  Width="200"
                                  Class="mt-4 mb-4" />

                    </MudPaper>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Payments"
                           OnClick="MakePayment"
                           Class="mt-4">
                    Pay Parking Charge
                </MudButton>                

            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">
                Parking details not found for registration number '@RegistrationNumber'
            </MudAlert>
        }
    }

    @if (PaymentSuccessful)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4">
            Parking charge paid successfully for registration number '@RegistrationNumber'. Thank you for parking with us and have a safe journey.
        </MudAlert>
    }

</MudPaper>